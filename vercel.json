{
  "github": {
    "silent": true
  },

  "cleanUrls": true,
  "trailingSlash": false,

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],

  "redirects": [
    {
      "source": "/github",
      "destination": "https://github.com/d-melita"
    },
    {
      "source": "/gh",
      "destination": "https://github.com/d-melita"
    },
    {
      "source": "/insta",
      "destination": "https://instagram.com/_dmelita"
    },
    {
      "source": "/twitter",
      "destination": "https://twitter.com/_dmelita"
    }
  ]
}
